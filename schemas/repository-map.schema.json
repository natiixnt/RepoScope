{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reposcope.dev/schema/repository-map.schema.json",
  "title": "RepoScope Repository Map",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "repository_name",
    "repository_path",
    "detected_languages",
    "module_map",
    "dependency_graph",
    "entrypoints",
    "entrypoint_reachability",
    "module_criticality",
    "critical_paths",
    "service_boundaries",
    "api_surfaces",
    "cycles",
    "configs",
    "tests",
    "stats"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository_name": {
      "type": "string"
    },
    "repository_path": {
      "type": "string"
    },
    "detected_languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "module_map": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "dependency_graph": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependencyEdge"
      }
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entrypoint"
      }
    },
    "entrypoint_reachability": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entrypointReachability"
      }
    },
    "module_criticality": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/moduleCriticality"
      }
    },
    "critical_paths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criticalPath"
      }
    },
    "service_boundaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/serviceBoundary"
      }
    },
    "api_surfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/apiSurface"
      }
    },
    "cycles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cycle"
      }
    },
    "configs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "required": [
        "name",
        "path",
        "language",
        "files",
        "internal_dependencies",
        "transitive_internal_dependencies",
        "external_dependencies"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "internal_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transitive_internal_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "external_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dependencyEdge": {
      "type": "object",
      "required": ["source", "target", "kind"],
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      }
    },
    "entrypoint": {
      "type": "object",
      "required": ["path", "reason"],
      "properties": {
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "framework": {
          "type": ["string", "null"]
        }
      }
    },
    "entrypointReachability": {
      "type": "object",
      "required": [
        "entrypoint_path",
        "reason",
        "start_modules",
        "reachable_modules"
      ],
      "properties": {
        "entrypoint_path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "start_modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reachable_modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "moduleCriticality": {
      "type": "object",
      "required": ["module", "score", "signals"],
      "properties": {
        "module": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "criticalPath": {
      "type": "object",
      "required": ["path", "reason", "priority"],
      "properties": {
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        }
      }
    },
    "serviceBoundary": {
      "type": "object",
      "required": ["name", "path", "signals"],
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "apiSurface": {
      "type": "object",
      "required": ["name", "path", "surface_type", "details"],
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "surface_type": {
          "type": "string"
        },
        "details": {
          "type": "string"
        }
      }
    },
    "cycle": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2
    }
  }
}
